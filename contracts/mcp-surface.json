    {
      "name": "notes_list",
      "title": "List notes",
      "description": "Browse notes newest first. Filter by dates or release. Follow cursor until null.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Local note day, YYYY-MM-DD",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "through": {
            "type": "string",
            "description": "Local note day, YYYY-MM-DD",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "release": {
            "type": "string",
            "description": "A year of life, for example 5.4",
            "pattern": "^\\d{1,3}\\.[0-9]$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "description": "Opaque continuation returned by this tool",
            "maxLength": 2048
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "server_version": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "next_step": {
            "type": "string"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "type": "integer"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "server_version"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "notes_search",
      "title": "Search notes",
      "description": "Find every word or quoted phrase, ignoring case and accents, across text, place, link titles and existing transcripts/descriptions. No automatic processing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Local note day, YYYY-MM-DD",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "through": {
            "type": "string",
            "description": "Local note day, YYYY-MM-DD",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "release": {
            "type": "string",
            "description": "A year of life, for example 5.4",
            "pattern": "^\\d{1,3}\\.[0-9]$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "description": "Opaque continuation returned by this tool",
            "maxLength": 2048
          },
          "q": {
            "type": "string",
            "description": "Words or quoted phrases",
            "maxLength": 200
          },
          "tag": {
            "type": "string",
            "description": "A lowercase hashtag without #",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "server_version": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "next_step": {
            "type": "string"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "type": "integer"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "server_version"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
