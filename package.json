{
  "name": "yvn-release-notes",
  "private": true,
  "description": "Release Notes: React web app, Node HTTP servers and event workers.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint web/src packages server workers tools tests-node --deny-warnings",
    "format": "prettier --write --no-error-on-unmatched-pattern \"web/**/*.{ts,tsx,html}\" \"{packages,server,workers,tools,tests-node}/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"web/**/*.{ts,tsx,html}\" \"{packages,server,workers,tools,tests-node}/**/*.ts\" \"*.{ts,json}\"",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run typecheck:server && npm run test:server && npm run build:server",
    "e2e": "vite build && playwright test --config e2e/playwright.config.mjs",
    "test:server": "node --import tsx --test \"tests-node/**/*.test.ts\"",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "build:server": "node --import tsx tools/build-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-cloudformation": "3.1150.0",
    "@aws-sdk/client-cloudwatch": "3.1150.0",
    "@aws-sdk/client-dynamodb": "3.1150.0",
    "@aws-sdk/client-geo-maps": "3.1150.0",
    "@aws-sdk/client-geo-places": "3.1150.0",
    "@aws-sdk/client-lambda": "3.1150.0",
    "@aws-sdk/client-lambda-web": "3.1150.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/client-secrets-manager": "3.1150.0",
    "@aws-sdk/client-sesv2": "3.1150.0",
    "@aws-sdk/client-sns": "3.1150.0",
    "@aws-sdk/client-sqs": "3.1150.0",
    "@aws-sdk/client-sts": "3.1150.0",
    "@aws-sdk/client-transcribe": "3.1150.0",
    "@aws-sdk/lib-dynamodb": "3.1150.0",
    "@aws-sdk/s3-presigned-post": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@hono/node-server": "2.1.4",
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "entities": "8.1.0",
    "heic-decode": "2.1.0",
    "hono": "4.13.13",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.57.0",
    "mailparser": "3.9.47",
    "maplibre-gl": "6.13.0",
    "nodemailer": "10.1.7",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mailparser": "3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
